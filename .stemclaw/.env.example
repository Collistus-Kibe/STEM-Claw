# StemClaw Environment Configuration Example
# Copy this file to .stemclaw/.env and fill in your keys.
# Secrets are NEVER passed to the model context.

# Meta Model API (dev.meta.ai)
# Get your API key from https://dev.meta.ai/platform/
META_API_KEY=
META_MODEL=muse-spark
META_API_BASE=https://api.meta.ai/v1

# Alternative: LLAMA API
LLAMA_API_KEY=
LLAMA_MODEL=muse-spark

# Optional endpoint keys (for higher rate limits / authenticated endpoints)
# [1] Life Sciences
NCBI_API_KEY=

# [2] Physical Sciences / Materials
MATERIALS_PROJECT_API_KEY=
OPENALEX_MAILTO=researcher@example.com
CROSSREF_MAILTO=researcher@example.com

# [3] Engineering & CS
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
IEEE_API_KEY=

# [4] Earth & Environmental
NASA_API_KEY=
NOAA_TOKEN=
DATA_GOV_KEY=

# [5] Interdisciplinary
CORE_API_KEY=
UNPAYWALL_EMAIL=researcher@example.com

